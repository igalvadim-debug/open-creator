{
  "local_only": true,
  "llm": {
    "base_url": "http://127.0.0.1:8484/v1",
    "default_model": "Qwen3-8B-Q4_K_M.gguf",
    "coding_model": "Qwen2.5-Coder-7B-Instruct-Q4_K_M.gguf",
    "models_dir": "./local-stack/models",
    "available_models": [
      "Qwen2.5-Coder-7B-Instruct-Q4_K_M.gguf",
      "Qwen3-8B-Q4_K_M.gguf",
      "gemma-3n-E4B-it-QAT-Q4_K_XL.gguf",
      "Qwen3-4B-Instruct-2507-Q8_0.gguf",
      "gemma-3-4b-it-qat-q4_0-gguf.gguf"
    ],
    "vision_mmproj": "mmproj-gemma-3-4b-it-qat-F16.gguf"
  },
  "embeddings": {
    "base_url": "http://127.0.0.1:8512/v1",
    "model": "embeddinggemma-300m-qat-Q8_0.gguf",
    "fallback_model": "bge-m3-Q8_0.gguf",
    "batch_size": 8,
    "chunk_lines": 30,
    "allow_free_tier": false
  },
  "vector_db": {
    "engine": "lancedb",
    "dir": "./lancedb_context",
    "http_port": 8003,
    "mcp_port": 8001,
    "repomapper_port": 8002
  },
  "translation": {
    "engine": "local_llm",
    "prompt_file": "./config/prompts/translation.txt",
    "languages": ["ru", "de", "en"]
  },
  "stt": {
    "engine": "faster-whisper",
    "model": "base",
    "models_dir": "./local-stack/models/whisper",
    "alternatives": ["whisper.cpp (./local-stack/bin/whisper-cli)", "whisperX"]
  },
  "tts": {
    "backend": "piper",
    "voice": "ru_RU-ruslan-medium",
    "model_path": "./local-stack/models/tts",
    "language": "ru",
    "speaker": "default",
    "speed": 1.0,
    "alternatives": ["coqui_xtts_v2", "f5tts", "openai_compat(local)"],
    "prefer_cwbuilder_tts_catalog": true
  },
  "image_generation": {
    "engine": "comfyui",
    "url": "http://127.0.0.1:8291",
    "catalog": "./cwbuilder-docs/cw_local_catalog.json",
    "workflow": "./config/workflows/image_default.json",
    "width": 1024,
    "height": 1024,
    "prompt_enhancer": "./cwbuilder-docs/cw_prompt_enhance.py"
  },
  "video_generation": {
    "engine": "comfyui",
    "url": "http://127.0.0.1:8197",
    "workflows_dir": "./cwbuilder-docs",
    "workflows": [
      "workflow_minimax_turbo_4step.json",
      "workflow_minimax_turbo_complete.json",
      "workflow_minimax_video.json",
      "workflow_magical_forest.json"
    ],
    "default_model": "minimax_h3_fl2va_pruned_w6a8.safetensors",
    "width": 1024,
    "height": 1024,
    "batch_size": 1,
    "timeout_s": 3600
  },
  "editing": {
    "engine": "ffmpeg+comfyui",
    "capabilities": ["trim", "concat", "subtitle_burn", "audio_mix", "effects_via_comfyui"]
  },
  "ports": {
    "llm": 8484,
    "embeddings": 8512,
    "mcp": 8001,
    "repomapper": 8002,
    "lancedb": 8003,
    "comfyui_image": 8291,
    "comfyui_video": 8197
  }
}
