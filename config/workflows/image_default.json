{
  "name": "image_default",
  "description": "Local text-to-image via ComfyUI :8291 (models from cw_local_catalog.json)",
  "local_only": true,
  "defaults": {
    "width": 1024, "height": 1024, "batch_size": 1, "timeout_s": 3600,
    "checkpoint": "auto:checkpoints", "vae": "auto:vae", "steps": 25, "cfg": 6.0
  },
  "nodes": [
    {"id": 1, "type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "PROMPT_HERE_NOT_USED.safetensors"}},
    {"id": 2, "type": "CLIPTextEncode", "inputs": {"text": "PROMPT_HERE"}, "title": "positive"},
    {"id": 3, "type": "CLIPTextEncode", "inputs": {"text": "lowres, blurry, watermark"}, "title": "negative"},
    {"id": 4, "type": "EmptyLatentImage", "inputs": {"width": 1024, "height": 1024, "batch_size": 1}},
    {"id": 5, "type": "KSampler", "inputs": {"seed": -1, "steps": 25, "cfg": 6.0, "sampler_name": "dpmpp_2m", "scheduler": "karras", "denoise": 1.0}},
    {"id": 6, "type": "VAEDecode", "inputs": {}},
    {"id": 7, "type": "SaveImage", "inputs": {"filename_prefix": "output/image"}}
  ],
  "links": [[1,0,5,0],[2,0,5,1],[3,0,5,2],[4,0,5,3],[5,0,6,0],[1,2,6,1],[6,0,7,0]]
}
