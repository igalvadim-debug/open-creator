# open-creator LOCAL — конфигурация полностью локального режима.
# Скопировать в .env (или ~/.opencreator/.env.local). Внешних AI-вызовов нет.

# Главный переключатель локализации daemon/агентов:
# при 1 все LLM/TTS/STT/embedding-провайдеры принудительно идут на local-stack.
OPENCREATOR_LOCAL=1

# Локальные эндпоинты (llama.cpp / local-stack; значения по умолчанию совпадают с local-stack/config.py)
LOCAL_LLM_BASE_URL=http://127.0.0.1:8484/v1
LOCAL_LLM_MODEL=Qwen3-8B-Q4_K_M.gguf
LOCAL_EMBED_BASE_URL=http://127.0.0.1:8512/v1
LOCAL_TTS_BASE_URL=http://127.0.0.1:8484/v1/audio/speech
LOCAL_WHISPER_MODEL=base            # base|small|medium — по VRAM
LOCAL_TTS_BACKEND=piper             # piper|coqui|f5tts|openai_compat
LOCAL_MCP_PORT=8001
LOCAL_REPOMAPPER_PORT=8002
LOCAL_LANCEDB_PORT=8003

# Free-tier fallback для эмбеддингов — единственный допустимый внешний канал.
# По умолчанию ВЫКЛЮЧЕН (0). Включать только осознанно.
ALLOW_FREE_TIER=0

# Cloud-ключи в локальном режиме НЕ нужны и не читаются (см. env-local.ts).
# Оставлены пустыми для совместимости со старой инсталляцией:
VOLCENGINE_APP_ID=
VOLCENGINE_ACCESS_TOKEN=
